{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/|favicon.ico|icon.svg|pwa-).*|apple-touch-icon.png|sw.js|workbox-.*)",
      "destination": "/index.html"
    }
  ]
}
